{
  "version": 1,
  "lineLength": 120,
  "indentation": { "spaces": 4 },
  "tabWidth": 4,
  "respectsExistingLineBreaks": true,
  "lineBreakBeforeControlFlowKeywords": false,
  "lineBreakBeforeEachArgument": false,
  "prioritizeKeepingFunctionOutputTogether": true,
  // The repository's style has no trailing commas in multi-line collections; swift-format's
  // default adds them, which is what made the first adoption attempt fight swiftlint (#0106).
  "multiElementCollectionTrailingCommas": false
}
